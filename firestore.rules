rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId));
    }

    function householdDocAfter(householdId) {
      return getAfter(/databases/$(database)/documents/households/$(householdId));
    }

    function isMember(householdId) {
      return signedIn() && request.auth.uid in householdDoc(householdId).data.memberIds;
    }

    function isMemberAfter(householdId) {
      return signedIn() && request.auth.uid in householdDocAfter(householdId).data.memberIds;
    }

    function canJoinWithInvite(householdId) {
      let invite = get(/databases/$(database)/documents/invites/$(resource.data.activeInviteCode));
      return signedIn()
        && invite.data.active == true
        && invite.data.householdId == householdId
        && request.auth.uid in request.resource.data.memberIds;
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /households/{householdId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if isMember(householdId);
      allow update: if isMember(householdId) || canJoinWithInvite(householdId);
      allow delete: if false;
    }

    match /householdMembers/{memberId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && isMemberAfter(request.resource.data.householdId);
      allow read, update: if isMember(resource.data.householdId);
      allow delete: if false;
    }

    match /invites/{inviteId} {
      allow create, update, read: if signedIn();
      allow delete: if false;
    }

    match /lists/{listId} {
      allow create: if signedIn() && isMemberAfter(request.resource.data.householdId);
      allow read, update: if signedIn() && isMember(resource.data.householdId);
      allow delete: if false;
    }

    match /listItems/{itemId} {
      allow create: if signedIn() && isMemberAfter(request.resource.data.householdId);
      allow read, update: if signedIn() && isMember(resource.data.householdId);
      allow delete: if false;
    }

    match /monthlyTemplates/{templateId} {
      allow create: if signedIn() && isMemberAfter(request.resource.data.householdId);
      allow read, update: if signedIn() && isMember(resource.data.householdId);
      allow delete: if false;
    }

    match /receipts/{receiptId} {
      allow create: if signedIn() && isMemberAfter(request.resource.data.householdId);
      allow read, update: if signedIn() && isMember(resource.data.householdId);
      allow delete: if false;
    }

    match /productSnapshots/{snapshotId} {
      allow create: if signedIn() && isMemberAfter(request.resource.data.householdId);
      allow read, update: if signedIn() && isMember(resource.data.householdId);
      allow delete: if false;
    }
  }
}
